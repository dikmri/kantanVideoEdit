{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kantan Video Edit",
  "version": "1.0.0",
  "identifier": "app.kantan.videoedit",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kantan Video Edit",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/bin/*"],
    "externalBin": [],
    "copyright": "",
    "category": "AudioVideo",
    "shortDescription": "Fast, lightweight, cross-platform video editor",
    "longDescription": "Kantan Video Edit is a simple but fully-featured video editor: import, trim, split, filters, text overlays, fades, multilingual UI, and fast FFmpeg-based export."
  }
}
